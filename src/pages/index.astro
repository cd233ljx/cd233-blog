---
import EmptyState from '../components/EmptyState.astro';
import PostList from '../components/PostList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagPool from '../components/TagPool.astro';
import { CONTENT } from '../config/site';
import { renderMarkdown } from '../lib/markdown.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllTags, getPosts } from '../lib/posts';

const posts = await getPosts();
const latestPosts = [...posts]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, CONTENT.home.recentCount);
const tags = getAllTags(posts).slice(0, CONTENT.home.tagCount);
---

<BaseLayout>
  <section class="home-intro page-container" aria-labelledby="home-title">
    <h1 id="home-title">{CONTENT.home.title}</h1>
    <p class="home-caption">{CONTENT.home.caption}</p>
    <div
      class="intro-copy article-prose prose"
      set:html={renderMarkdown(CONTENT.home.intro)}
    />
  </section>

  {
    CONTENT.home.showRecent && (
      <section id="latest" class="home-section page-container">
        <SectionHeading
          title={CONTENT.home.recentTitle}
          href="/posts/"
          linkLabel={CONTENT.home.recentLink}
        />
        {latestPosts.length > 0 ? (
          <PostList posts={latestPosts} headingLevel="h3" />
        ) : (
          <EmptyState />
        )}
      </section>
    )
  }

  {
    CONTENT.home.showTags && tags.length > 0 && (
      <section id="topics" class="home-section topics-section page-container">
        <SectionHeading
          title={CONTENT.home.tagsTitle}
          href="/tags/"
          linkLabel={CONTENT.home.tagsLink}
        />
        <TagPool tags={tags} />
      </section>
    )
  }
</BaseLayout>
