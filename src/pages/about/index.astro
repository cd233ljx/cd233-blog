---
import { CONTENT } from '../../config/site';
import { renderMarkdown } from '../../lib/markdown.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={CONTENT.about.pageTitle}
  description={CONTENT.about.description}
>
  <header class="about-hero page-container">
    <div class="about-copy">
      <h1>{CONTENT.about.heading}</h1>
      <div
        class="about-lead article-prose prose"
        set:html={renderMarkdown(CONTENT.about.lead)}
      />
    </div>
  </header>
  <div class="about-notes page-container">
    <div
      class="article-prose prose"
      set:html={renderMarkdown(CONTENT.about.body)}
    />
  </div>
</BaseLayout>
