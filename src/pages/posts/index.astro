---
import { CONTENT } from '../../config/site';
import PostList from '../../components/PostList.astro';
import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title={CONTENT.posts.title} description={CONTENT.posts.description}>
  <header class="page-hero page-container">
    <h1>{CONTENT.posts.title}</h1>
    <p>{CONTENT.posts.intro}</p>
  </header>

  <section class="listing-section page-container">
    {posts.length > 0 ? <PostList posts={posts} /> : <EmptyState />}
  </section>
</BaseLayout>
