---
import { CONTENT, formatText } from '../../config/site';
import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPosts } from '../../lib/posts';

const tags = getAllTags(await getPosts());
---

<BaseLayout title={CONTENT.tags.title} description={CONTENT.tags.description}>
  <header class="page-hero page-container">
    <h1>{CONTENT.tags.title}</h1>
    <p>{CONTENT.tags.intro}</p>
  </header>

  <section class="listing-section page-container">
    {
      tags.length > 0 ? (
        <div class="tag-index">
          {tags.map((tag) => (
            <a href={`/tags/${tag.slug}/`}>
              <span>#{tag.name}</span>
              <small>
                {formatText(CONTENT.navigation.shortCount, {
                  count: tag.count,
                })}
              </small>
            </a>
          ))}
        </div>
      ) : (
        <EmptyState title={CONTENT.tags.empty} />
      )
    }
  </section>
</BaseLayout>
