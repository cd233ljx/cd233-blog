---
import { CONTENT, formatText } from '../../config/site';
import { ChevronDown } from '@lucide/astro';

import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostHref, getPosts, type Post } from '../../lib/posts';

const posts = await getPosts();
const dateFormatter = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const weekdayFormatter = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  weekday: 'short',
});

type ArchiveDay = {
  key: string;
  monthDay: string;
  weekday: string;
  posts: Post[];
};

const yearMaps = new Map<number, Map<string, ArchiveDay>>();

for (const post of posts) {
  const parts = Object.fromEntries(
    dateFormatter
      .formatToParts(post.data.publishedAt)
      .filter(({ type }) => type !== 'literal')
      .map(({ type, value }) => [type, value]),
  );
  const year = Number(parts.year);
  const key = `${parts.year}-${parts.month}-${parts.day}`;
  const days = yearMaps.get(year) ?? new Map<string, ArchiveDay>();
  const day = days.get(key) ?? {
    key,
    monthDay: `${parts.month}.${parts.day}`,
    weekday: weekdayFormatter.format(post.data.publishedAt),
    posts: [],
  };

  day.posts.push(post);
  days.set(key, day);
  yearMaps.set(year, days);
}

const groupedYears = [...yearMaps.entries()].map(([year, days]) => ({
  year,
  days: [...days.values()],
  postCount: [...days.values()].reduce(
    (count, day) => count + day.posts.length,
    0,
  ),
}));
---

<BaseLayout
  title={CONTENT.archive.title}
  description={CONTENT.archive.description}
>
  <header class="page-hero page-container archive-hero">
    <h1 class="archive-heading">{CONTENT.archive.title}</h1>
    <p>{CONTENT.archive.intro}</p>
  </header>

  <section class="listing-section page-container">
    {
      groupedYears.length > 0 ? (
        <div class="archive-list">
          {groupedYears.map(({ year, days, postCount }) => (
            <section class="archive-year">
              <div class="archive-year-label">
                <span>{year}</span>
                <small>
                  {formatText(CONTENT.navigation.articleCount, {
                    count: postCount,
                  })}
                </small>
              </div>
              <div class="archive-timeline">
                {days.map((day) => (
                  <div class="archive-day">
                    <time class="archive-date" datetime={day.key}>
                      <strong>{day.monthDay}</strong>
                      <small>{day.weekday}</small>
                    </time>
                    {day.posts.length > 1 ? (
                      <details class="archive-day-details">
                        <summary class="archive-day-summary">
                          <span>
                            <strong>
                              {formatText(CONTENT.navigation.articleCount, {
                                count: day.posts.length,
                              })}
                            </strong>
                            <small>{CONTENT.archive.expand}</small>
                          </span>
                          <ChevronDown size={17} aria-hidden="true" />
                        </summary>
                        <div class="archive-day-posts">
                          {day.posts.map((post) => (
                            <a href={getPostHref(post)} class="archive-item">
                              <span class="archive-title">
                                {post.data.title}
                              </span>
                            </a>
                          ))}
                        </div>
                      </details>
                    ) : (
                      <div class="archive-day-posts">
                        {day.posts.map((post) => (
                          <a href={getPostHref(post)} class="archive-item">
                            <span class="archive-title">{post.data.title}</span>
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <EmptyState />
      )
    }
  </section>
</BaseLayout>
