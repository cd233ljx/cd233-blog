---
import { Image } from 'astro:assets';
import { CalendarDays, Clock3, RefreshCcw } from '@lucide/astro';
import 'katex/dist/katex.min.css';

import PostList from '../components/PostList.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import { SITE, CONTENT, formatText } from '../config/site';
import {
  formatPostDate,
  getReadingMinutes,
  getRelatedPosts,
  getTagHref,
  type Post,
} from '../lib/posts';
import { renderMarkdown } from '../lib/markdown.mjs';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: Post;
  headings: Heading[];
  allPosts: Post[];
}

const { post, headings, allPosts } = Astro.props;
const relatedPosts = getRelatedPosts(post, allPosts);
const canonical = new URL(`/posts/${post.id}/`, SITE.url);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: SITE.locale,
  mainEntityOfPage: canonical.toString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
  },
  keywords: post.data.tags.join(', '),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  noIndex={post.data.draft}
>
  <ReadingProgress />

  <article class="post-page" data-pagefind-body>
    <header class="post-hero page-container">
      <div class="post-hero-content">
        {
          post.data.draft && (
            <div class="post-kicker">
              <span class="draft-badge">{CONTENT.article.draft}</span>
            </div>
          )
        }
        <h1
          data-pagefind-meta="title"
          transition:name={`post-title-${post.id}`}
        >
          {post.data.title}
        </h1>
        <p class="post-deck">{post.data.description}</p>
        <div class="post-meta-row">
          <span>
            <CalendarDays size={15} aria-hidden="true" />
            {formatPostDate(post.data.publishedAt)}
          </span>
          <span>
            <Clock3 size={15} aria-hidden="true" />
            {
              formatText(CONTENT.article.readingTime, {
                minutes: getReadingMinutes(post),
              })
            }
          </span>
          {
            post.data.updatedAt && (
              <span>
                <RefreshCcw size={14} aria-hidden="true" />
                {formatText(CONTENT.article.updated, {
                  date: formatPostDate(post.data.updatedAt),
                })}
              </span>
            )
          }
        </div>
      </div>
    </header>

    {
      post.data.cover && (
        <div class="post-cover page-container">
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            widths={[720, 1080, 1440, 1920]}
            sizes="(min-width: 720px) 656px, calc(100vw - 48px)"
            loading="eager"
          />
        </div>
      )
    }

    <div class="post-layout page-container">
      <div class="post-aside" data-pagefind-ignore>
        <TableOfContents headings={headings} />
      </div>
      <div class="post-content">
        <div class="article-prose prose prose-lg max-w-none">
          <slot />
        </div>
        <SeriesNavigation post={post} posts={allPosts} />
        <footer class="post-footer">
          <div>
            <p class="eyebrow">{CONTENT.article.tags}</p>
            <div class="tag-list tag-list-large">
              {
                post.data.tags.map((tag) => (
                  <a href={getTagHref(tag)}>#{tag}</a>
                ))
              }
            </div>
          </div>
          <div
            class="article-prose prose"
            set:html={renderMarkdown(CONTENT.article.footer)}
          />
        </footer>
      </div>
    </div>
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="related-section page-container">
        <SectionHeading title={CONTENT.article.related} />
        <PostList posts={relatedPosts} headingLevel="h3" />
      </section>
    )
  }

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')}
  />
</BaseLayout>
