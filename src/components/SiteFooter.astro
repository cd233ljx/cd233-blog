---
import { CONTENT, SITE, formatText } from '../config/site';
import { renderMarkdown } from '../lib/markdown.mjs';
const year = new Date().getFullYear();
const socialLinks = [
  { href: SITE.social.github, label: 'GitHub' },
  { href: SITE.social.x, label: 'X' },
  { href: SITE.social.bilibili, label: 'Bilibili' },
  { href: SITE.email ? `mailto:${SITE.email}` : '', label: SITE.email },
].filter((link) => link.href);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-bar">
      <a class="footer-brand" href="/">{CONTENT.footer.brand}</a>
      <nav aria-label="页脚导航">
        {
          CONTENT.footer.links.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
      <div class="footer-meta">
        {
          CONTENT.footer.showSocial &&
            socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label}
              </a>
            ))
        }
        <span
          >{
            formatText(CONTENT.footer.copyright, { year, author: SITE.author })
          }</span
        >
      </div>
    </div>
    {
      CONTENT.footer.note && (
        <div
          class="footer-note article-prose prose"
          set:html={renderMarkdown(CONTENT.footer.note)}
        />
      )
    }
  </div>
</footer>
