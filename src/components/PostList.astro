---
import { CONTENT, formatText } from '../config/site';
import { Image } from 'astro:assets';

import {
  formatPostDate,
  getPostHref,
  getReadingMinutes,
  getTagHref,
  type Post,
} from '../lib/posts';

interface Props {
  posts: Post[];
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel: Heading = 'h2' } = Astro.props;
const shortDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-list-item">
        <article class="post-list-entry">
          <div class="post-list-copy">
            <Heading
              class="post-list-title"
              transition:name={`post-title-${post.id}`}
            >
              <a href={getPostHref(post)}>{post.data.title}</a>
            </Heading>
            <p class="post-list-description">{post.data.description}</p>
            <div class="post-list-meta">
              {post.data.draft && (
                <span class="draft-badge">{CONTENT.article.listDraft}</span>
              )}
              <span>
                {formatText(CONTENT.article.shortReadingTime, {
                  minutes: getReadingMinutes(post),
                })}
              </span>
              <div class="tag-list" aria-label="文章标签">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <a href={getTagHref(tag)}>#{tag}</a>
                ))}
              </div>
            </div>
          </div>
          <time
            class="post-list-date"
            datetime={post.data.publishedAt.toISOString()}
            title={formatPostDate(post.data.publishedAt)}
          >
            {shortDate.format(post.data.publishedAt)}
          </time>
          {post.data.cover && (
            <a
              class="post-list-cover"
              href={getPostHref(post)}
              aria-label={`阅读《${post.data.title}》`}
            >
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt ?? ''}
                widths={[320, 640]}
                sizes="160px"
                loading="lazy"
              />
            </a>
          )}
        </article>
      </li>
    ))
  }
</ul>
