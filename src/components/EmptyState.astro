---
import { CONTENT } from '../config/site';
import { FileText } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = CONTENT.navigation.emptyTitle,
  description = CONTENT.navigation.emptyDescription,
} = Astro.props;
---

<div class="empty-state">
  <span class="empty-icon"><FileText size={22} aria-hidden="true" /></span>
  <h2>{title}</h2>
  <p>{description}</p>
</div>
