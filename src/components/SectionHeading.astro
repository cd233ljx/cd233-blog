---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = '查看全部',
} = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {title && <h2>{title}</h2>}
    {description && <p class="section-description">{description}</p>}
  </div>
  {
    href && (
      <a class="text-link" href={href}>
        {linkLabel}
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    )
  }
</div>
