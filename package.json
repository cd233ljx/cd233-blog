{
  "name": "cd233-blog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "dev:background": "astro dev --host 0.0.0.0 --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:stop": "astro dev stop",
    "build": "npm run check:astro && npm run build:site",
    "build:site": "astro build && pagefind --site dist",
    "check": "npm run check:astro && npm run test && npm run format:check",
    "check:astro": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new:post": "node scripts/new-post.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run build:site",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@lucide/astro": "^1.31.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.8",
    "katex": "^0.18.3",
    "mermaid": "^11.16.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
