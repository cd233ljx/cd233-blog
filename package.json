{
  "name": "cd233-blog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "dev:background": "astro dev --host 0.0.0.0 --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:stop": "astro dev stop",
    "build": "npm run check:astro && npm run build:site",
    "build:site": "astro build && pagefind --site dist",
    "check": "npm run check:astro && npm run test && npm run format:check",
    "check:astro": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new:post": "node scripts/new-post.mjs",
    "new:series": "node scripts/new-series.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run build:site",
    "astro": "astro",
    "admin:start": "node --env-file=.env.admin scripts/admin/server.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@lucide/astro": "^1.31.0",
    "@mdxeditor/editor": "^4.3.3",
    "@radix-ui/react-slider": "^1.6.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.8",
    "decode-named-character-reference": "^1.3.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "mermaid": "^11.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
